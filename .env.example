# Copy this file to .env and set the values for your environment.
# Keep .env private; it is excluded from Git.
DATABASE_BACKEND=sqlite
DATABASE_URL=
DATABASE_SSLMODE=require

# Used only when DATABASE_URL is blank and DATABASE_BACKEND=postgresql.
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Redis. Leave blank to use the in-memory fakeredis fallback.
REDIS_URL=
CACHE_POLICY=lru
CACHE_CAPACITY=64
CACHE_FLUSH_INTERVAL=30
CACHE_MAX_DIRTY=100
